<Window x:Class="Zhizhuxia.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智助侠"
        Width="410"
        Height="600"
        MinWidth="360"
        MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#5905080C" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#7A05080C" />
    <SolidColorBrush x:Key="LineBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#79F2DC" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8787" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F8C66B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1F1F1F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1F1F1F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#303030" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4F4F4" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#24000000" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Width="4" Background="#252B33" CornerRadius="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#0B0B0B" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid TextElement.Foreground="{StaticResource TextBrush}">
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="#0B0B0B"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock Margin="{TemplateBinding Padding}"
                         IsHitTestVisible="False"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextBrush}"
                         Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}" />
              <Path HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Margin="0,0,10,0"
                    Fill="{StaticResource TextBrush}"
                    Data="M 0 0 L 4 4 L 8 0 Z" />
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border Background="#0B0B0B"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer Margin="2"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#16000000" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#242424" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#202020" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootPanel"
          Background="Transparent"
          BorderBrush="#1FFFFFFF"
          BorderThickness="0"
          CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar"
              Grid.Row="0"
              Background="Transparent"
              Margin="14,10,14,0"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="16"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="30" Height="21" Margin="0,0,10,0">
              <Canvas Width="120" Height="84">
                <Path x:Name="HeaderEyeOuter"
                      Data="M8 43 C26 9 68 2 112 13 C95 50 59 78 17 76 C10 65 6 54 8 43 Z"
                      Fill="Transparent"
                      Stroke="#CCFFFFFF"
                      StrokeThickness="8"
                      StrokeLineJoin="Round" />
                <Path x:Name="HeaderEyeAccent"
                      Data="M22 45 C38 24 67 17 96 22 C82 47 56 62 29 62"
                      Fill="Transparent"
                      Stroke="#B8FF334D"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Text="智助侠 Agent" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Ctrl+Alt+F9 · HUD 模式" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="隐藏" Width="50" Height="30" MinHeight="30" Margin="0,0,8,0" Click="HideButton_Click" />
            <Button Content="×" Width="34" Height="30" MinHeight="30" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid x:Name="ChatView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AgentPill"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="9,7"
                    Background="#12FFFFFF"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Agent" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,3" />
                <ComboBox Grid.Row="1" x:Name="AgentComboBox" SelectedIndex="0" MinHeight="28" Padding="5,3" BorderThickness="0" Background="Transparent">
                  <ComboBoxItem Tag="chief" Content="总控" />
                  <ComboBoxItem Tag="research" Content="检索" />
                  <ComboBoxItem Tag="mechanics" Content="机制" />
                  <ComboBoxItem Tag="build" Content="配装" />
                  <ComboBoxItem Tag="route" Content="路线" />
                  <ComboBoxItem Tag="combat" Content="战斗" />
                  <ComboBoxItem Tag="critic" Content="审查" />
                </ComboBox>
              </Grid>
            </Border>

            <Border x:Name="GamePill"
                    Grid.Column="1"
                    Padding="9,7"
                    Background="#12FFFFFF"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Game" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,3" />
                <TextBox Grid.Row="1"
                         x:Name="GameNameBox"
                         MinHeight="28"
                         Padding="5,3"
                         BorderThickness="0"
                         Background="Transparent" />
              </Grid>
            </Border>
          </Grid>

          <ScrollViewer x:Name="ChatScrollViewer"
                        Grid.Row="1"
                        Margin="14,0"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MessageStack" Margin="0,6,0,14">
            </StackPanel>
          </ScrollViewer>

          <Border x:Name="ScreenshotPreviewPanel"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  Margin="14,0,14,8"
                  Padding="9"
                  Background="#24000000"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ScreenshotPreviewText"
                         Text="已添加截图"
                         Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center"
                         FontSize="12" />
              <Button Grid.Column="1" Content="清除" Width="54" Click="ClearScreenshotButton_Click" />
            </Grid>
          </Border>

          <Border x:Name="ComposerShell"
                  Grid.Row="3"
                  Margin="14,0,14,14"
                  Padding="6"
                  Background="#12FFFFFF"
                  BorderBrush="#22FFFFFF"
                  BorderThickness="1"
                  CornerRadius="16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button x:Name="ScreenshotButton"
                      Width="34"
                      Height="36"
                      MinHeight="36"
                      Margin="0,0,4,0"
                      ToolTip="区域截图"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Click="ScreenshotButton_Click">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="32" Height="32">
                    <Path x:Name="ScreenshotIcon"
                          Data="M8 11 L8 8 C8 6.9 8.9 6 10 6 L14 6 M18 6 L22 6 C23.1 6 24 6.9 24 8 L24 11 M24 21 L24 24 C24 25.1 23.1 26 22 26 L18 26 M14 26 L10 26 C8.9 26 8 25.1 8 24 L8 21 M11 13 L21 13 L21 20 L11 20 Z"
                          Fill="Transparent"
                          Stroke="{StaticResource TextBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
              </Button>
              <TextBox Grid.Column="1"
                       x:Name="MessageBox"
                       BorderThickness="0"
                       Background="#0B0B0B"
                       MinHeight="42"
                       MaxHeight="120"
                       Padding="6,8"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       KeyDown="MessageBox_KeyDown" />
              <Button x:Name="SendButton"
                      Grid.Column="2"
                      Width="34"
                      Height="36"
                      MinHeight="36"
                      Margin="4,0,0,0"
                      ToolTip="发送"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Foreground="#07110F"
                      Click="SendButton_Click">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="32" Height="32">
                    <Path x:Name="SendIcon"
                          Data="M8 16 L25 7 L20 25 L16 18 L8 16 Z M16 18 L25 7"
                          Fill="Transparent"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1.9"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
