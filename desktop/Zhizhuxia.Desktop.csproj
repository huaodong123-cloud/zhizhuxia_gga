<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\icons\zhizhuxia-spider-eye.ico</ApplicationIcon>
    <AssemblyName>智助侠</AssemblyName>
    <Product>智助侠</Product>
    <Version>0.0.1-demo</Version>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>demov0.01-concept</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Zhizhuxia.Desktop.Tests\**" />
    <Page Remove="Zhizhuxia.Desktop.Tests\**" />
    <None Remove="Zhizhuxia.Desktop.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\package.json"
          Link="package.json"
          TargetPath="package.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\server\src\**\*"
          Link="server\src\%(RecursiveDir)%(Filename)%(Extension)"
          TargetPath="server\src\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
