<Window x:Class="Zhizhuxia.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智助侠配置"
        Width="460"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#05080C" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#10151D" />
    <SolidColorBrush x:Key="LineBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#79F2DC" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#10151D" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#10151D" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#141A22" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Width="4" Background="#252B33" CornerRadius="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Grid MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="智助侠配置" FontSize="20" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="×" Width="34" Height="30" MinHeight="30" Click="CancelButton_Click" />
      </Grid>
      <TextBlock Text="API Key 和外观配置会保存到本机缓存。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18" />

      <Border Background="{StaticResource PanelSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="模型密钥" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock Text="智谱 API Key" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <PasswordBox x:Name="ZhipuKeyBox" PasswordChar="•" />
        </StackPanel>
      </Border>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="文本模型" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <TextBlock Text="GLM-5.2 · 智谱文本" Background="{StaticResource PanelSoftBrush}" Padding="10,8" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0">
          <TextBlock Text="视觉模型" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <TextBlock Text="GLM-5.2 · 智谱视觉" Background="{StaticResource PanelSoftBrush}" Padding="10,8" />
        </StackPanel>
      </Grid>

      <TextBlock Text="快捷键" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="显示/隐藏" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <TextBox Text="Ctrl + Alt + F9" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0">
          <TextBlock Text="区域截图" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <TextBox Text="Ctrl + Alt + F10" />
        </StackPanel>
      </Grid>

      <Border Background="{StaticResource PanelSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock Text="图标颜色" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="IconColorWhiteRadio" GroupName="IconColor" Content="白色" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,14,0" />
            <RadioButton x:Name="IconColorRedRadio" GroupName="IconColor" Content="红色" Foreground="{StaticResource TextBrush}" Margin="0,0,14,0" />
            <RadioButton x:Name="IconColorCyanRadio" GroupName="IconColor" Content="青绿色" Foreground="{StaticResource TextBrush}" Margin="0,0,14,0" />
            <RadioButton x:Name="IconColorDimRadio" GroupName="IconColor" Content="低亮灰" Foreground="{StaticResource TextBrush}" />
          </StackPanel>

          <TextBlock Text="图标透明度" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <Slider x:Name="IconOpacitySlider" Minimum="20" Maximum="100" Value="70" Margin="0,0,0,12" />

          <TextBlock Text="面板透明度" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <Slider x:Name="PanelOpacitySlider" Minimum="35" Maximum="75" Value="45" Margin="0,0,0,12" />

          <TextBlock Text="气泡透明度" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
          <Slider x:Name="BubbleOpacitySlider" Minimum="55" Maximum="100" Value="82" Margin="0,0,0,14" />

          <CheckBox x:Name="TopmostCheckBox" Content="置顶" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,0,8" />
          <CheckBox x:Name="ClickThroughCollapsedOnlyCheckBox" Content="鼠标穿透：仅收起态" Foreground="{StaticResource TextBrush}" />
        </StackPanel>
      </Border>

      <Button x:Name="SaveButton" Content="保存本次会话配置" Background="{StaticResource AccentBrush}" Foreground="#101010" Click="SaveButton_Click" />
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
